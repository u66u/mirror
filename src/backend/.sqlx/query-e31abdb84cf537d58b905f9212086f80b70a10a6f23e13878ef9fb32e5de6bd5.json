{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, device_name, user_agent, created_at, last_seen_at, expires_at\n        FROM sessions\n        WHERE owner_id = $1\n          AND revoked_at IS NULL\n          AND expires_at > now()\n        ORDER BY COALESCE(last_seen_at, created_at) DESC\n        ",
