  "db_name": "PostgreSQL",
  "query": "\n        SELECT a.id, a.owner_id, o.storage_key, o.media_type\n        FROM assets a\n        JOIN originals o ON o.id = a.original_id\n        WHERE a.id = $1\n          AND a.trashed_at IS NULL\n        ",
