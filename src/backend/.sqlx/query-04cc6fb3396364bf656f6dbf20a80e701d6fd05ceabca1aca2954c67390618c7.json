  "query": "\n        SELECT id, model_pack_id, status, total_assets, queued_assets, processed_assets, failed_assets\n        FROM model_reindex_runs\n        WHERE model_pack_id = $1\n          AND status IN ('queued', 'running')\n        ORDER BY created_at DESC, id DESC\n        LIMIT 1\n        ",
